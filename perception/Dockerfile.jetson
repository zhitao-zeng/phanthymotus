# Obstacle-only Jetson image. Build from the repository root:
#   docker build -f perception/Dockerfile.jetson --network=host \
#     --build-arg JP_VERSION=61 \
#     -t phanthymotus-perception-obstacle:jp61 .

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG JP_VERSION=61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
ARG PYPI_MIRROR APT_MIRROR

ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    PIP_TRUSTED_HOST="mirrors.tuna.tsinghua.edu.cn pypi.tuna.tsinghua.edu.cn pypi.org files.pythonhosted.org" \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    MALLOC_ARENA_MAX=2 \
    FASTDDS_BUILTIN_TRANSPORTS=UDPv4 \
    YOLO_CONFIG_DIR=/tmp

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" \
        /etc/apt/sources.list; \
    fi

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
      "numpy==1.26.4" \
      pyyaml

# Models are external artifacts. The downloader installs them atomically only
# after exact byte-size and SHA256 verification.
COPY perception/models/obstacle-artifacts.json /tmp/obstacle-artifacts.json
COPY perception/utils/obstacle_model_downloader.py /tmp/obstacle_model_downloader.py
RUN python3 /tmp/obstacle_model_downloader.py \
      --manifest /tmp/obstacle-artifacts.json \
      --timeout 120 \
      --retries 3

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
# The platform launches the service with the FastDDS profile at this path
# (same layout as the judge evaluation image). Ship it so rclpy/FastDDS does
# not fall back to an unparsed XML on every node start.
COPY perception/config/fastdds_large_message.xml /opt/phanthy-motus/config/fastdds_large_message.xml

RUN python3 -m py_compile \
      /work/main.py \
      /work/plugins/obstacle.py \
      /work/plugins/obstacle_distance_core/*.py \
      /work/utils/obstacle_model_downloader.py && \
    cd /work && python3 -c "from plugins.obstacle_distance_core.zipdepth_tensorrt_backends import create_backends; import os; paths=['/models/obstacle-distance/zipdepth-int8/zipdepth-base-npu-512x384-int8.engine', '/models/obstacle-distance/zipdepth-int8/yolo26n-depth-int8.engine', '/models/obstacle-distance/zipdepth-int8/yolo26n-seg-int8.engine']; assert all(os.path.isfile(path) for path in paths)"

EXPOSE 15720

CMD ["/bin/bash", "-c", \
    "if [ -f /opt/ros/humble/setup.bash ]; then \
       source /opt/ros/humble/setup.bash; \
     else \
       source /opt/ros/humble/install/setup.bash; \
     fi && \
     python3 /work/main.py"]
